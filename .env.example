# KidzGem Headless WordPress Backend Configuration
VITE_WP_API_URL=https://kidzgem.com
VITE_ENABLE_WP_BACKEND=true

# Resend (server-side only, used by /api/subscribe and /api/contact serverless
# functions - do NOT prefix with VITE_ or it will be bundled into client JS)
RESEND_API_KEY=
RESEND_FROM_EMAIL=KidzGem <onboarding@resend.dev>
STORE_NOTIFY_EMAIL=contactus@odhgroups.com
